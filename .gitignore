# Secrets and local environment
.env
.env.*
!.env.example
*.key
*.pem

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Temporary files
*.tmp
*.temp
*.bak
~$*

# Common generated caches
node_modules/
__pycache__/
*.py[cod]

# Personal raw sources stay local. Keep only structure documentation in Git.
members/*/raw/**
!members/*/raw/**/
!members/*/raw/**/README.md
!members/*/raw/**/.gitkeep

# Personal outputs stay local. Keep only structure documentation in Git.
members/*/output/**
!members/*/output/**/
!members/*/output/**/README.md
!members/*/output/**/.gitkeep

# Project raw sources and generated outputs follow the same local-only boundary.
projects/raw/**
!projects/raw/**/
!projects/raw/**/README.md
!projects/raw/**/.gitkeep
projects/output/**
!projects/output/**/
!projects/output/**/README.md
!projects/output/**/.gitkeep

# Private and secret project/member data stays local.
projects/private/**
projects/secrets/**
members/*/private/**
members/*/secrets/**
members/*/PROFILE.private.md
members/*/CONTEXT.private.md
members/*/.wiki-migration-backup/
.vercel
.env*
!.env.example
