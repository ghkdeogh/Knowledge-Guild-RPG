# Secrets and local environment
.env
.env.*
!.env.example
*.key
*.pem

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Temporary files
*.tmp
*.temp
*.bak
~$*

# Common generated caches
node_modules/
__pycache__/
*.py[cod]

# Every member's personal Wiki is local-only. Keep just this repository guide.
members/**
!members/
!members/README.md

# Project raw sources and generated outputs follow the same local-only boundary.
projects/raw/**
!projects/raw/**/
!projects/raw/**/README.md
!projects/raw/**/.gitkeep
projects/output/**
!projects/output/**/
!projects/output/**/README.md
!projects/output/**/.gitkeep

# Private and secret project/member data stays local.
projects/private/**
projects/secrets/**
members/*/private/**
members/*/secrets/**
members/*/PROFILE.private.md
members/*/CONTEXT.private.md
members/*/.wiki-migration-backup/

# Local BMAD runtime, outputs, and agent-tool state are never repository content.
_bmad/
_bmad-output/
.agents/skills/bmad-*/
.claude/
.vercel
.env*
!.env.example
